{
  "name": "pet-next",
  "version": "0.1.0",
  "private": true,
  "description": "单宠物、单屏的透明置顶桌宠。",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node scripts/copy-static.mjs",
    "start": "pnpm build && node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/unit-tests.mjs",
    "test:cleanup": "node --experimental-strip-types --test --test-reporter spec tests/cleanup.test.ts tests/support/process-tree.test.ts tests/support/process-table.test.ts tests/support/run-record.test.ts tests/support/record-cli.test.ts",
    "test:integration": "node --experimental-strip-types assets-pipeline/cli.ts",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 --test-reporter spec tests/*.e2e.test.ts",
    "preflight": "node scripts/preflight.mjs",
    "record:platform": "node scripts/record-platform-run.mjs",
    "verify": "node scripts/preflight.mjs --require=unit,integration,cleanup,e2e && pnpm typecheck && pnpm lint && pnpm test && pnpm test:cleanup && pnpm test:integration && pnpm build && pnpm test:e2e",
    "verify:windows": "powershell -File tests/platform/verify-windows.ps1",
    "assets:check": "node --experimental-strip-types assets-pipeline/cli.ts",
    "assets:short": "node --experimental-strip-types assets-pipeline/short-clip.ts",
    "experiment:arbiter": "node --experimental-strip-types experiments/arbiter/runner/main.ts",
    "experiment:arbiter:check": "node --experimental-strip-types experiments/arbiter/check/main.ts",
    "experiment:arbiter:demo": "node --experimental-strip-types experiments/arbiter/demo/main.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron"]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "electron": "43.3.0",
    "eslint": "^10.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0"
  }
}

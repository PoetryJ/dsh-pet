{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "outDir": "../dist/bench-build",
    "rootDir": "..",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["../dist", "../node_modules"]
}

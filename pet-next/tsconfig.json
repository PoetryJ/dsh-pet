{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["core/**/*.ts", "adapters/**/*.ts", "app/**/*.ts", "electron/main.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules", "electron/preload.ts"]
}
